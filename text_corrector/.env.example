# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Turan Text Corrector API"
VERSION="1.0.0"
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (used by FastAPI CORS middleware)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Text limits ───────────────────────────────────────────────────────────────
MAX_TEXT_LENGTH=5000

# ── Correction thresholds ─────────────────────────────────────────────────────
# Minimum rapidfuzz similarity score (0.0–1.0) to accept a correction candidate
CORRECTION_SIMILARITY_THRESHOLD=0.55
# Maximum Levenshtein edit distance for a candidate to be accepted
MAX_EDIT_DISTANCE=3

# ── Trained model paths ───────────────────────────────────────────────────────
# Leave empty to use the built-in dictionary/edit-distance placeholder.
# Set to a local directory or HuggingFace model ID when your model is ready.
#
# Example:
#   RUSSIAN_MODEL_PATH=/models/russian_spellchecker
#   KAZAKH_MODEL_PATH=/models/kazakh_spellchecker
#
RUSSIAN_MODEL_PATH=
KAZAKH_MODEL_PATH=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_REQUESTS=true
